[Unit]
Description=PixelWise API - Hotswap Mode
After=network.target

[Service]
User=produser
WorkingDirectory=/opt/pixelwise
EnvironmentFile=/opt/pixelwise/.env
ExecStart=/opt/pixelwise/.venv/bin/gunicorn \
app.main:app --worker-class uvicorn.workers.UvicornWorker \
--workers 3 --bind 0.0.0.0:8000 \
--timeout 120
Restart=always
[Install]
WantedBy=multi-user.target
